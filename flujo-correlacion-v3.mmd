flowchart TB
  M["Lectura de antena<br/>(dato simulado)"]
  R["Reporte del usuario<br/>(portal Amplify)"]
  CLASS["ClasificadoraDeMetricas<br/>(AWS Lambda)"]
  TEL["Telemetry<br/>(DynamoDB tabla)"]
  CREATE["CrearReporte<br/>(AWS Lambda)"]
  REP["Reports + CorrelationMembers<br/>(DynamoDB, 2 tablas)"]
  OUT["Outbox + Streams<br/>(DynamoDB tabla + feature)"]
  ROUTER["EnrutadoraDeOutbox<br/>(AWS Lambda)"]
  BUS["OperacionesBus<br/>(EventBridge bus)"]
  AQ["ColaAnomalias + DLQ<br/>(SQS, nuevo v3)"]
  AC["CorrelacionadoraDeAnomalias<br/>(AWS Lambda, nueva v3)"]
  RQ["ColaReportes + DLQ<br/>(SQS)"]
  RC["CorrelacionadoraDeReportes<br/>(AWS Lambda)"]
  CAT["NetworkCatalog<br/>(DynamoDB tabla: cobertura)"]
  INC["Incidents<br/>(DynamoDB tabla: incident_id y punteros)"]
  CHECK{"Misma zona + cobertura<br/>+ tiempo compatible?<br/>(regla de negocio)"}
  REVIEW["Revisión del operador<br/>(si hay varios candidatos)"]
  SFN["VerificarIncidente<br/>(Step Functions Standard)"]

  M --> CLASS --> TEL
  CLASS -->|evento por episodio| OUT
  R --> CREATE --> REP -->|transaccion| OUT
  OUT --> ROUTER --> BUS
  BUS -->|telemetry.anomaly| AQ --> AC --> CAT
  CAT -->|zona cubierta| INC
  AC -->|enlaza caso activo o crea sospecha| INC
  BUS -->|report.created| RQ --> RC --> CHECK
  INC -->|candidato activo| CHECK
  CHECK -->|uno, enlazar al mismo ID| INC
  CHECK -->|ambiguo| REVIEW
  CHECK -->|sin candidato, 10 usuarios| INC
  INC -->|incidente nuevo o evidencia nueva| SFN
