# Inventario local del despliegue. Copiar a azure/.env y completar.
# Este archivo no configura automaticamente la Function ni Cloud Shell.
AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_RESOURCE_GROUP=rg-red-telecorp-estado-dev
AZURE_DEPLOYMENT_NAME=red-telecorp-azure-dev
AZURE_ENVIRONMENT=dev
AZURE_LOCATION=eastus2
AZURE_STATIC_LOCATION=centralus
AZURE_FUNCTION_APP_NAME=red-telecorp-estado-api-xxxxxxxx
AZURE_FUNCTION_BASE_URL=https://red-telecorp-estado-api-xxxxxxxx.azurewebsites.net
AZURE_STATIC_WEB_APP_NAME=red-telecorp-estado-publico-xxxxxxxx
AZURE_STATIC_WEB_APP_URL=https://xxxxxxxx.azurestaticapps.net
AZURE_STORAGE_ACCOUNT_NAME=sttelecorpxxxxxxxxxx
AZURE_TABLE_NAME=EstadoZonas

# Nunca guardar aqui Function keys, connection strings ni deployment tokens.
# La clave aws-publisher se entrega al equipo AWS por un canal privado.
