# Solo valores no secretos. Copiar a azure/.env y completar localmente.
AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_RESOURCE_GROUP=rg-red-telecorp-estado-dev
AZURE_LOCATION=eastus2
AZURE_STATIC_LOCATION=centralus
AZURE_ENVIRONMENT=dev

# Compartir con AWS por canal privado luego del despliegue:
